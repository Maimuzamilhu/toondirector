# Copy this file to .env and put your key in it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# vision model: looks at video frames and draws the characters/backgrounds
DEEPSEEK_VISION_MODEL=deepseek-flash
# times DeepSeek reviews its drawing against the video and fixes it (0-3)
REVIEW_PASSES=1
# frames per second DeepSeek watches: 5 / 10 / 15 / 30 / all (every frame)
WATCH_FPS=10

# Whisper speech-to-text model on CPU: tiny (fastest) / base / small (more accurate, slower)
WHISPER_MODEL=base
